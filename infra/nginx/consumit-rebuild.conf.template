# Container IPs change on every redeploy, and a static upstream block would
# pin the first address forever (stale 502s). Resolving per request
# through the embedded DNS keeps the gateway correct without reloads.
resolver 127.0.0.11 valid=10s;
split_clients "${remote_addr}${http_user_agent}" $playback_target {
  ${CONSUMIT_PLAYBACK_CANARY_PERCENT}% ${CONSUMIT_PLAYBACK_PRIMARY_UPSTREAM};
  * api-legacy:3001;
}

server {
  listen 80;
  server_name consumit.online _;

  include /etc/nginx/consumit-request-limits.conf;

  location = /v1/internal/animekai-pow {
    set $upstream_playback http://${CONSUMIT_PLAYBACK_PRIMARY_UPSTREAM};
    proxy_pass $upstream_playback;
    proxy_read_timeout 12s;
    access_log off;
  }
  location ^~ /v1/internal/ { return 404; }
  location = /v1/subtitles/preferences {
    set $upstream_api http://api:3001;
    proxy_pass $upstream_api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  location = /v1/subtitles {
    set $upstream_playback http://$playback_target;
    proxy_pass $upstream_playback;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 20s;
  }
  location ^~ /v1/subtitles/ {
    set $upstream_playback http://$playback_target;
    proxy_pass $upstream_playback;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 20s;
  }
  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location = /health/ready {
    access_log off;
    set $upstream_api http://api:3001;
    proxy_pass $upstream_api;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-store, private" always;
    proxy_cache off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 10s;
  }

  # Capabilities are opaque credentials; never record their query strings.
  location = /v1/playback/relay-manifest {
    access_log off;
    error_log /dev/null;
    set $upstream_api http://$playback_target;
    proxy_pass $upstream_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 15s;
  }

  # Three bounded provider tiers can take up to 60s to discover a source.
  location ~ ^/v1/(playback/|embed/session) {
    set $upstream_api http://$playback_target;
    proxy_pass $upstream_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 70s;
  }

  # Allow the 15s Admin inspection deadline to return its structured outcome.
  location = /v1/admin/providers/inspect {
    set $upstream_api http://api:3001;
    proxy_pass $upstream_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 20s;
  }

  location /v1/ {
    set $upstream_api http://api:3001;
    proxy_pass $upstream_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 15s;
  }

  # Reserved until the product introduces an authenticated WebSocket surface.
  location ^~ /ws/ {
    return 404;
  }

  location / {
    set $upstream_web http://web:3000;
    proxy_pass $upstream_web;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }
}
