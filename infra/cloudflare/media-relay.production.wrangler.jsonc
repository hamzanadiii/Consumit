{
  "name": "consumit-media-relay-production",
  "main": "../../packages/media-relay/src/worker.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "vars": {
    "APP_ORIGIN": "https://consumit.online",
    "RELAY_ENABLED": "true",
    "RELAY_PROVIDERS": "{}",
    "RELAY_DISCOVERY_PROVIDERS": "{}",
    "RELAY_ROUTE_POLICY": "[]",
    "RELAY_ROUTE_POLICY_REQUIRED": "true"
  }
}
