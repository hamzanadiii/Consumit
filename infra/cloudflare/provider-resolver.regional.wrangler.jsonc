{
  "name": "consumit-provider-resolver-europe",
  "main": "../../packages/media-relay/src/resolver-worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "placement": { "region": "aws:eu-west-3" },
  "observability": { "enabled": true, "head_sampling_rate": 0.01, "logs": { "enabled": true, "invocation_logs": false } },
  "vars": { "RESOLVER_ENABLED": "true" }
}
