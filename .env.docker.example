# Copy this file to .env before running Docker Compose.
CONSUMIT_PORT=8080
APP_ORIGIN=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:8080
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# `off` hides the consent prompt; anything else keeps the Allow/Decline prompt.
NEXT_PUBLIC_GA_PROMPT=on
# Optional public inbox used to prepare member issue-report emails.
SUPPORT_EMAIL=consumit.project@proton.me

CONSUMIT_POSTGRES_PASSWORD=consumit-local
AUTH_CODE_PEPPER=replace-with-at-least-32-random-characters
RESEND_API_KEY=replace-with-a-domain-restricted-sending-key
AUTH_EMAIL_FROM=Consumit <auth@your-verified-domain.example>
# Optional Google OAuth web client; add APP_ORIGIN/v1/auth/google/callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TMDB_API_READ_TOKEN=replace-with-your-api-read-access-token
# Optional official MyAnimeList API fallback; Jikan is keyless.
MAL_CLIENT_ID=

TMDB_LANGUAGE=en-US
TMDB_REGION=US
CONSUMIT_API_NODE_ENV=development
TRUSTED_PROXIES=172.16.0.0/12

# Production has its own .env.production, generated by production:prepare.
# See .env.production.example and docs/runbooks/cloudflare-production.md.
