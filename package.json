{
  "name": "consumit",
  "private": true,
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun --env-file=apps/api/.env --watch apps/api/src/index.ts",
    "dev:web": "bun --filter @consumit/web dev",
    "dev:infra": "docker compose -f compose.yaml -f compose.dev.yaml -f compose.playback.yaml --profile playback up postgres valkey playback-valkey",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up --build",
    "docker:dev": "docker compose -f compose.yaml -f compose.dev.yaml up",
    "docker:dev:watch": "docker compose -f compose.yaml -f compose.dev.yaml up --watch",
    "docker:web:fast": "docker compose -f compose.yaml build web && docker compose -f compose.yaml up -d --no-deps --no-build web",
    "docker:dev:playback": "docker compose -f compose.yaml -f compose.dev.yaml -f compose.playback.yaml --profile playback up --watch --build",
    "build": "bun run --sequential --workspaces --if-present build",
    "lint": "bun run --sequential --workspaces --if-present lint",
    "typecheck": "bun run --sequential --workspaces --if-present typecheck",
    "test": "bun run --sequential --workspaces --if-present test && node --test scripts/*.test.mjs",
    "test:playback": "node node_modules/@playwright/test/cli.js test",
    "test:social": "node node_modules/@playwright/test/cli.js test --config tests/social/playwright.config.ts",
    "test:experience": "node node_modules/@playwright/test/cli.js test --config tests/experience/playwright.config.ts",
    "test:releases": "node node_modules/@playwright/test/cli.js test --config tests/releases/playwright.config.ts",
    "infra:validate": "node scripts/validate-infra.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "production:prepare": "node scripts/production.mjs prepare",
    "production:check": "node scripts/production.mjs check",
    "production:build": "node scripts/production.mjs build",
    "production:up": "node scripts/production.mjs up",
    "production:smoke": "node scripts/production.mjs smoke",
    "backup:run": "node scripts/production.mjs backup",
    "backup:check": "node scripts/production.mjs backup-check",
    "backup:physical": "node scripts/production.mjs physical-backup",
    "backup:retention-drill": "node scripts/production.mjs retention-drill",
    "backup:recover": "node scripts/recover-production.mjs",
    "backup:offline": "node scripts/offline-recovery.mjs",
    "aws:credit-check": "node scripts/production.mjs credit-check",
    "aws:identity-check": "node scripts/production.mjs aws-identity-check",
    "test:recovery": "node scripts/drill-postgres.mjs",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0 <27"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
