{
  "name": "consumit",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --workspaces --if-present dev",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up --build",
    "docker:dev": "docker compose -f compose.yaml -f compose.dev.yaml up",
    "docker:dev:watch": "docker compose -f compose.yaml -f compose.dev.yaml up --watch",
    "docker:dev:playback": "docker compose -f compose.yaml -f compose.dev.yaml -f compose.playback.yaml --profile playback up",
    "build": "bun run --sequential --workspaces --if-present build",
    "lint": "bun run --sequential --workspaces --if-present lint",
    "typecheck": "bun run --sequential --workspaces --if-present typecheck",
    "test": "bun run --sequential --workspaces --if-present test",
    "test:playback": "node node_modules/@playwright/test/cli.js test",
    "infra:validate": "node scripts/validate-infra.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "backup:run": "docker compose -f compose.yaml -f compose.production.yaml --profile backup run --rm backup",
    "backup:check": "docker compose -f compose.yaml -f compose.production.yaml --profile backup run --rm --entrypoint consumit-backup-check backup",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0 <27"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
