# Run: node scripts/production.mjs prepare
# Edit the ignored .env.production privately. No development env files are used.
APP_ORIGIN=https://consumit.online
NEXT_PUBLIC_SITE_URL=https://consumit.online
SUPPORT_EMAIL=consumit.project@proton.me
AUTH_CODE_PEPPER=replace-with-generated-production-secret
AUTH_EMAIL_FROM="Consumit <auth@consumit.online>"
RESEND_API_KEY=replace-with-domain-restricted-sending-key
TMDB_API_READ_TOKEN=replace-with-api-read-token
# Use the reviewed production database's DIRECT endpoint, not its pooler.
DATABASE_URL=postgresql://replace-user:replace-password@database.example:5432/consumit?sslmode=verify-full
DATABASE_SSL_MODE=require
TMDB_LANGUAGE=en-US
TMDB_REGION=US
TRUSTED_PROXIES=172.16.0.0/12
CONSUMIT_POSTGRES_PASSWORD=replace-with-generated-local-container-password
CLOUDFLARE_TUNNEL_TOKEN=replace-with-provisioned-tunnel-token
CONSUMIT_PROVIDER_CONFIG=./infra/playback/providers.local.json
PLAYBACK_RELAY_ENABLED=false
# Enable Relay only after API/Worker origins, secret and host policies agree.
# PLAYBACK_RELAY_ORIGIN=https://your-reviewed-worker.workers.dev
# PLAYBACK_RELAY_SECRET=replace-with-independent-relay-secret
# PLAYBACK_RELAY_PROVIDERS={}
# PLAYBACK_RELAY_DISCOVERY_PROVIDERS={}
RESTIC_REPOSITORY=sftp:storage-box:/backups/consumit
RESTIC_PASSWORD_FILE=./infra/secrets/restic-password
STORAGE_BOX_SSH_DIR=./infra/secrets/ssh
ALERTMANAGER_CONFIG=./infra/secrets/alertmanager.yml
BACKUP_HOST=consumit-production
