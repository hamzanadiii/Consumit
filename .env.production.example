# Run production:prepare; fill AWS/Cloudflare accounts with scripts/deploy-wizard.sh.
APP_ORIGIN=https://consumit.online
NEXT_PUBLIC_SITE_URL=https://consumit.online
SUPPORT_EMAIL=consumit.project@proton.me
AUTH_CODE_PEPPER=replace-with-generated-production-secret
AUTH_EMAIL_FROM="Consumit <auth@consumit.online>"
AUTH_EMAIL_PROVIDER=ses
SES_REGION=ca-central-1
SES_CONFIGURATION_SET=consumit-auth
SES_FEEDBACK_QUEUE_URL=replace-with-feedback-queue-url
TMDB_API_READ_TOKEN=replace-with-api-read-token
DATABASE_DEPLOYMENT=self-hosted
DATABASE_SSL_MODE=require
DATABASE_SSL_CA_FILE=/run/secrets/db-ca.crt
DATABASE_URL=postgresql://consumit_app:replace-app-password@postgres:5432/consumit?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.crt
MIGRATION_DATABASE_URL=postgresql://consumit_migrate:replace-migration-password@postgres:5432/consumit?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.crt
BACKUP_DATABASE_URL=postgresql://consumit_backup:replace-backup-password@postgres:5432/consumit?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.crt
TMDB_LANGUAGE=en-US
TMDB_REGION=US
TRUSTED_PROXIES=172.16.0.0/12
CONSUMIT_RELEASE=local
CONSUMIT_PROVIDER_CONFIG=./infra/playback/providers.local.json
# This release keeps the existing playback relay on Free.
PLAYBACK_RELAY_ENABLED=false
AWS_BACKUP_BUCKET=replace-with-backup-bucket
RESTIC_REPOSITORY=s3:https://s3.ca-central-1.amazonaws.com/replace-with-backup-bucket/restic
RESTIC_PASSWORD_FILE=./infra/secrets/restic-password
ALERTMANAGER_CONFIG=./infra/secrets/alertmanager.yml
BACKUP_HOST=consumit-production
# Record the actual credit expiry in the account console; never infer it.
AWS_CREDIT_EXPIRES_AT=replace-with-actual-credit-expiry-ISO-date
TELEGRAM_CHAT_ID=replace-with-numeric-chat-id
CF_UPTIME_KV_ID=replace-with-external-monitor-kv-id
