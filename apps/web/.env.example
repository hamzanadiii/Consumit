CONSUMIT_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_SITE_URL=https://consumit.online
# Leave unset locally. Public GA4 measurement ID is compiled at build time.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# `off` hides the consent prompt; anything else keeps the Allow/Decline prompt.
NEXT_PUBLIC_GA_PROMPT=on
# Optional public inbox used to prepare member issue-report emails.
SUPPORT_EMAIL=consumit.project@proton.me
# Set to next on a canary web deployment. Default retains the current controller.
# Route canary traffic at the edge so each deployment serves one player core.
NEXT_PUBLIC_PLAYBACK_CORE=legacy
# Custom CAF receiver app ID from the Cast Developer Console; set before building.
# Unset: Cast opens setup guidance and does not load the Cast SDK.
NEXT_PUBLIC_CAST_RECEIVER_ID=
NEXT_PUBLIC_CONSUMIT_WELCOME_ENABLED=false
NEXT_PUBLIC_CONSUMIT_DISCORD_URL=https://discord.gg/p7XVyk6vs
NEXT_PUBLIC_CONSUMIT_REDDIT_URL=https://www.reddit.com/r/Consumit/
