PORT=3001
APP_ORIGIN=http://localhost:3000
TRUSTED_PROXIES=
DATABASE_URL=postgresql://postgres:consumit-dev@127.0.0.1:5432/consumit
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA=
# Managed Postgres (Neon): use the DIRECT (non-pooled) URL, keep the
# ?sslmode=require suffix Neon gives you, and flip this switch:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/consumit?sslmode=require
# DATABASE_SSL_MODE=require
VALKEY_URL=valkey://127.0.0.1:6379/0
AUTH_CODE_PEPPER=replace-with-at-least-32-random-characters
RESEND_API_KEY=replace-with-a-domain-restricted-sending-key
AUTH_EMAIL_FROM=Consumit <auth@your-verified-domain.example>
TMDB_API_READ_TOKEN=replace-with-your-api-read-access-token
TMDB_LANGUAGE=en-US
TMDB_REGION=US

# VPS-disk subtitle storage: converted VTT plus original (srt/vtt/ass)
# source bytes under <dir>/tmdb/<kind>/<id>/<s>/<e>/<lang>/. Unset keeps
# the store backend (Valkey/memory, converted VTT only).
# SUBTITLES_DIR=/var/lib/consumit/subtitles

# Configured providers supply validated media; playback starts browser-direct.
# Optional Worker fallback for separately declared relay providers (Free supported).
# Existing providers default to deliveryMode: direct and are never auto-relayed.
# Worker env must match APP_ORIGIN, RELAY_SECRET and RELAY_PROVIDERS.
PLAYBACK_RELAY_ENABLED=false
# Optional provider-bound media discovery. Both API registration and Worker
# must explicitly enable the same reviewed recipe. Other providers stay static.
# PLAYBACK_RELAY_DISCOVERY_PROVIDERS={"stormboron":"storm-boron-v1","wecollege-miami":"wecollege-city-v1","wecollege-boise":"wecollege-city-v1"}
# PLAYBACK_RELAY_ORIGIN=https://YOUR-EXACT-WORKER.workers.dev
# PLAYBACK_RELAY_SECRET=replace-with-at-least-32-random-characters
# PLAYBACK_RELAY_PROVIDERS={"owned-media":["media.your-domain.example"]}
# An empty {} map keeps the relay ready without enrolling any providers.
PLAYBACK_ENABLED=false
PLAYBACK_VALKEY_URL=valkey://playback-valkey:6379/0
# PLAYBACK_MEDIA_CONFIG=/run/consumit/providers.json
# Static entries are the easy path for your own HLS. Load is bounded per
# provider (concurrency, rate limits) and by the resolver's candidate window.
# Optional OTLP/HTTP collector, e.g. http://collector:4318. No export when unset.
OTEL_EXPORTER_OTLP_ENDPOINT=
