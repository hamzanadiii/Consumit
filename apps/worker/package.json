{
  "name": "@consumit/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "bun build src/index.ts src/browser.ts src/retry.ts --target=node --outdir=dist --external=playwright",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@consumit/contracts": "workspace:*",
    "@consumit/server": "workspace:*",
    "@consumit/db": "workspace:*",
    "bullmq": "6.3.14",
    "ioredis": "6.0.0",
    "playwright": "1.63.0",
    "zod": "^4.5.4",
    "@opentelemetry/api": "^1.9.0",
    "@consumit/observability": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "vitest": "^4.1.11"
  }
}
